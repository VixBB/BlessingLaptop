<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/header_home"
        android:paddingTop="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="14dp"
            android:text="Penambahan laptop"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/header_layout"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nama Laptop -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Nama Laptop" />

            <EditText
                android:id="@+id/et_laptop_name"
                style="@style/add_laptop_input"
                android:hint="Ketik nama laptop" />

            <!-- Deskripsi Laptop -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Deskripsi" />

            <EditText
                android:id="@+id/et_laptop_description"
                style="@style/add_laptop_input"
                android:layout_height="100dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:hint="Ketik deskripsi laptop..." />

            <!-- Processor -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Processor" />

            <EditText
                android:id="@+id/et_processor"
                style="@style/add_laptop_input"
                android:hint="Contoh: Intel Core i7-12700H" />
            
            <!-- Graphics -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Graphics" />

            <EditText
                android:id="@+id/et_graphics"
                style="@style/add_laptop_input"
                android:hint="Contoh: NVIDIA GeForce RTX 3060" />

            <!-- RAM -->
            <TextView
                style="@style/add_laptop_label"
                android:text="RAM" />

            <EditText
                android:id="@+id/et_ram"
                style="@style/add_laptop_input"
                android:hint="Contoh: 16GB DDR5" />

            <!-- Storage -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Storage" />

            <EditText
                android:id="@+id/et_storage"
                style="@style/add_laptop_input"
                android:hint="Contoh: 1TB NVMe SSD" />

            <!-- Screen -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Screen" />

            <EditText
                android:id="@+id/et_screen"
                style="@style/add_laptop_input"
                android:hint="Contoh: 15.6 inch QHD 165Hz" />

            <!-- OS -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Operating System" />

            <EditText
                android:id="@+id/et_os"
                style="@style/add_laptop_input"
                android:hint="Contoh: Windows 11 Home" />

            <!-- Kategori -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Kategori" />

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field" />

            <!-- Gambar -->
            <TextView
                style="@style/add_laptop_label"
                android:text="Gambar" />

            <Spinner
                android:id="@+id/spinner_image"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field" />

            <Button
                android:id="@+id/btn_add_laptop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="40dp"
                android:text="TAMBAH"
                android:textColor="@color/white"
                app:backgroundTint="#003C91"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>